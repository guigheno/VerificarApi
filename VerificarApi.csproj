<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.5" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.5">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.5" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- Builda o front (VerifiCarFront) e copia o resultado para wwwroot, para que
       a API sirva o React em produção a partir da mesma origem (sem CORS/proxy). -->
  <Target Name="BuildFrontend" BeforeTargets="Publish">
    <Exec Command="npm install" WorkingDirectory="../VerifiCarFront" />
    <Exec Command="npm run build" WorkingDirectory="../VerifiCarFront" />
    <ItemGroup>
      <FrontendDist Include="../VerifiCarFront/dist/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendDist)" DestinationFolder="wwwroot/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>